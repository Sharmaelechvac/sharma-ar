{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharmaelechvac.github.io/sharma-ar/finance-data.schema.json",
  "title": "Sharma Electric & HVAC shared finance data (AR + P&L)",
  "type": "object",
  "required": [
    "meta",
    "invoices",
    "pnl"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "company",
        "asOf",
        "currency",
        "updatedBy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "company": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "description": "YYYY-MM-DD (or YYYY-MM-DDTHH:MM with offset) the numbers are current as of; empty string until Jarvis fills it"
        },
        "currency": {
          "const": "USD"
        },
        "updatedBy": {
          "type": "string"
        }
      }
    },
    "invoices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "client",
          "jobAddress",
          "trade",
          "amount",
          "dateSent",
          "dueTerms",
          "status",
          "datePaid",
          "retainage"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable unique key, never reused"
          },
          "number": {
            "type": "string",
            "description": "Invoice number as printed on the invoice"
          },
          "client": {
            "type": "string",
            "description": "Builder/client name, spelled the same on every invoice (this is the grouping key)"
          },
          "jobAddress": {
            "type": "string"
          },
          "trade": {
            "enum": [
              "electrical",
              "hvac"
            ]
          },
          "amount": {
            "type": "number",
            "description": "Invoice total in dollars, includes any retainage"
          },
          "dateSent": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dueTerms": {
            "type": "integer",
            "minimum": 0,
            "description": "Net days, e.g. 30. 0 = due on receipt"
          },
          "status": {
            "enum": [
              "sent",
              "paid",
              "overdue",
              "undelivered"
            ]
          },
          "datePaid": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "retainage": {
            "type": "number",
            "minimum": 0,
            "description": "Dollars held back by the builder on this invoice; 0 if none"
          }
        }
      }
    },
    "pnl": {
      "type": "object",
      "required": [
        "divisions",
        "months",
        "revenueBasis"
      ],
      "properties": {
        "divisions": {
          "const": [
            "electrical",
            "hvac"
          ]
        },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "month",
              "electrical",
              "hvac",
              "totals"
            ],
            "additionalProperties": false,
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "electrical": {
                "$ref": "#/$defs/division"
              },
              "hvac": {
                "$ref": "#/$defs/division"
              },
              "totals": {
                "$ref": "#/$defs/division"
              }
            }
          }
        },
        "revenueBasis": {
          "const": "billed",
          "description": "Fixed. Revenue is booked when invoiced (Sanjay 2026-11-15). pnl.months[].<div>.revenue = sum of invoices[].amount with that trade and dateSent in that month, retainage included."
        },
        "marginFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Margin floor as a fraction, e.g. 0.25"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "month",
              "name",
              "detail",
              "division",
              "houses",
              "revenue",
              "material",
              "labor",
              "other",
              "totalCost",
              "note",
              "flag"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
              },
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "name": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "division": {
                "enum": [
                  "electrical",
                  "hvac"
                ]
              },
              "houses": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "revenue": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Billed revenue on the job's invoices. null = not entered. 0 for cost-only rows."
              },
              "material": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "labor": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Crew labor incl. meter labor"
              },
              "other": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Permit / other"
              },
              "totalCost": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "null = cost TBD (left out of profit and margin)"
              },
              "note": {
                "type": "string"
              },
              "flag": {
                "enum": [
                  "",
                  "tbd",
                  "unassigned",
                  "costOnly"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "division": {
      "type": "object",
      "required": [
        "revenue",
        "costs",
        "profit"
      ],
      "additionalProperties": false,
      "properties": {
        "revenue": {
          "type": "number"
        },
        "costs": {
          "type": "object",
          "required": [
            "materials",
            "labor",
            "other",
            "total"
          ],
          "additionalProperties": false,
          "properties": {
            "materials": {
              "type": "number"
            },
            "labor": {
              "type": "number",
              "description": "Crew labor incl. meter labor"
            },
            "other": {
              "type": "number"
            },
            "total": {
              "type": "number",
              "description": "materials + labor + other"
            }
          }
        },
        "profit": {
          "type": "number",
          "description": "revenue - costs.total"
        }
      }
    }
  }
}